[gd_scene load_steps=4 format=2]

[ext_resource path="res://ai/ai.gd" type="Script" id=1]
[ext_resource path="res://ai/specs.gd" type="Script" id=2]
[ext_resource path="res://ai/search.gd" type="Script" id=3]

[node name="AI" type="Timer"]
script = ExtResource( 1 )

[node name="Specs" type="Node2D" parent="."]
