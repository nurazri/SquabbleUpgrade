        },
        "firebase-core": {
            "version": "0.1.0",
            "platforms": [],
            "dependencies": []
        },
        "firebase-analytics": {
            "version": "0.1.1",
            "platforms": [
                "all"
            ],
            "dependencies": [
                "firebase-core@0.1.0"
            ],
            "autoload": {
                "fba": "*res://scripts/fba.gd"
            }
        },
        "facebook": {
            "version": "9.3.0.1",
            "platforms": [
                "all"
            ],
            "dependencies": [
