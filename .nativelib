            }
        },
        "tenjin": {
            "version": "0.1.1",
            "platforms": [
                "all"
            ],
            "dependencies": [],
            "variables": {
                "Tenjin/ApiKey": {
                    "info": "Set your API key here"
                }
            },
            "autoload": {
                "tenjin": "*res://mobile/tenjin.tscn"
            }
        }
    }
